# Shoes Ecommerce API URL (no trailing slash).
# 1. Start the API: cd Ecommerce_api/Ecommerce_shoes && dotnet run
# 2. Start the UI: npm run dev
# 3. API must be running at this URL (default: http://localhost:5232)
VITE_API_URL=http://localhost:5232

# API keys (must match appsettings.json ApiClients). Dashboard uses Admin key, shop uses User key.
VITE_API_KEY_ADMIN=admin-key-xyz
VITE_API_KEY_USER=user-key-abc
